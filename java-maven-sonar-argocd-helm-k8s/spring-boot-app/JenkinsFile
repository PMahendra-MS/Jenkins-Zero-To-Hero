```groovy
pipeline {
    agent {
        docker {
            image 'admin1837/maven-abhishek-docker-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {

        stage('Checkout') {
            steps {
                sh '''
                    echo "===== CHECKOUT ====="

                    git config --global --add safe.directory "$WORKSPACE"

                    echo "Workspace:"
                    pwd

                    echo "Git status:"
                    git status

                    echo "Files:"
                    ls -ltr
                '''
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    echo "===== BUILD AND TEST ====="

                    cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                    mvn clean package
                '''
            }
        }

        stage('Static Code Analysis') {
            environment {
                SONAR_URL = 'http://23.22.130.20:9000'
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "===== SONARQUBE ANALYSIS ====="

                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:3.11.0.3922:sonar \
                            -Dsonar.host.url="$SONAR_URL" \
                            -Dsonar.token="$SONAR_AUTH_TOKEN"
                    '''
                }
            }
        }

        stage('Build and Push Docker Image') {
            environment {
                DOCKER_IMAGE = "admin1837/ultimate-cicd:${BUILD_NUMBER}"
            }

            steps {
                script {

                    sh '''
                        echo "===== DOCKER BUILD ====="

                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                        docker build -t "$DOCKER_IMAGE" .
                    '''

                    echo "===== DOCKER PUSH ====="

                    def dockerImage = docker.image("${DOCKER_IMAGE}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        dockerImage.push()
                    }
                }
            }
        }

        stage('Update Deployment File') {
            environment {
                GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
                GIT_USER_NAME = 'PMahendra-MS'
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "===== UPDATE DEPLOYMENT FILE ====="

                        # Allow Git to work with the Jenkins workspace
                        git config --global --add safe.directory "$WORKSPACE"

                        echo "Current workspace:"
                        pwd

                        echo "Current Git branch:"
                        git branch --show-current

                        echo "Current Git status:"
                        git status

                        echo "===== CONFIGURE GIT ====="

                        git config user.email "pmahendra9012@gmail.com"
                        git config user.name "Peravali Mahendra"

                        echo "===== UPDATE IMAGE TAG ====="

                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
                            java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                        echo "===== UPDATED DEPLOYMENT FILE ====="

                        cat java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                        echo "===== GIT STATUS ====="

                        git status

                        echo "===== GIT ADD ====="

                        git add \
                            java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                        echo "===== GIT COMMIT ====="

                        git commit \
                            -m "Update deployment image to version ${BUILD_NUMBER}"

                        echo "===== GIT PUSH ====="

                        git push \
                            "https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" \
                            HEAD:main

                        echo "===== DEPLOYMENT FILE PUSHED SUCCESSFULLY ====="
                    '''
                }
            }
        }
    }
}
```

    stage('Update Deployment File') {
      environment {
        GIT_REPO_NAME = "Jenkins-Zero-To-Hero"
        GIT_USER_NAME = "PMahendra-MS"
      }

      steps {
        withCredentials([
          string(
            credentialsId: 'github',
            variable: 'GITHUB_TOKEN'
          )
        ]) {

          sh '''
            set -e

            echo "===== Checking Git Repository ====="
            pwd
            git status

            echo "===== Configuring Git ====="
            git config user.email "pmahendra9012@gmail.com"
            git config user.name "Peravali Mahendra"

            echo "===== Updating Deployment File ====="

            sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
              java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

            echo "===== Deployment File ====="

            cat java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

            echo "===== Git Status ====="

            git status

            git add \
              java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

            git commit \
              -m "Update deployment image to version ${BUILD_NUMBER}"

            echo "===== Pushing Changes to GitHub ====="

            git push \
              https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
              HEAD:main
          '''
        }
      }
    }

  }
}
